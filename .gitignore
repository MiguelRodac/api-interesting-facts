# =============================================
# API Interesting Facts - .gitignore
# =============================================

# Compiled output
/build/
dist/
out/

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Environment variables (NEVER commit these)
.env

# Logs
logs/
*.log

# IDEs and editors
.vscode/

# OpenCode / Agent configs
.atl/
specs/
openspec/

# Postman local overrides
docs/postman/*.local.json
docs/API_GUIDE.md