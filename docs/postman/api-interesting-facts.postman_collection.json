    {
      "name": "Facts",
      "item": [
        {
          "name": "GET /facts",
          "event": [
            {
              "listen": "pre-request",
              "script": {
                "exec": [
                  "// Dynamic query param builder for GET /facts",
                  "// Reserved keys: page, limit, order_by, order_dir",
                  "// Filter keys: title__like, content__like, authorId__eq, createdAt__gte, createdAt__lte, etc.",
                  "",
                  "const params = {};",
                  "",
                  "// --- Reserved params ---",
                  "params.page = 1;",
                  "params.limit = 10;",
                  "params.order_by = 'createdAt';",
                  "params.order_dir = 'desc';",
                  "",
                  "// --- Dynamic filters (field__operation syntax) ---",
                  "// Operations: eq, like, gt, gte, lt, lte, in, between",
                  "params['title__like'] = 'honey';",
                  "// params['authorId__eq'] = pm.collectionVariables.get('testUserId');",
                  "// params['createdAt__gte'] = '2024-01-01';",
                  "// params['createdAt__lte'] = '2024-12-31';",
                  "",
                  "// Build query string",
                  "const query = Object.entries(params)",
                  "    .filter(([, v]) => v !== undefined && v !== null && v !== '')",
                  "    .map(([k, v]) => encodeURIComponent(k) + '=' + encodeURIComponent(v))",
                  "    .join('&');",
                  "",
                  "pm.request.url.update({",
                  "    raw: '{{baseUrl}}/facts?' + query",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/facts?page=1&limit=10&order_by=createdAt&order_dir=desc&title__like=honey",
              "host": ["{{baseUrl}}"],
              "path": ["facts"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page (default: 20)"
                },
                {
                  "key": "order_by",
                  "value": "createdAt",
                  "description": "Sort field: createdAt, likesCount (default: createdAt)"
                },
                {
                  "key": "order_dir",
                  "value": "desc",
                  "description": "Sort direction: asc, desc (default: desc)"
                },
                {
                  "key": "title__like",
                  "value": "honey",
                  "description": "Filter: title contains text (SQL LIKE %value%)"
                },
                {
                  "key": "authorId__eq",
                  "value": "",
                  "description": "Filter: exact author ID match",
                  "disabled": true
                },
                {
                  "key": "createdAt__gte",
                  "value": "",
                  "description": "Filter: createdAt >= date (YYYY-MM-DD)",
                  "disabled": true
                },
                {
                  "key": "content__like",
                  "value": "",
                  "description": "Filter: content contains text",
                  "disabled": true
                }
              ]
            },
            "description": "Get all facts sorted by newest first (public, no auth)\n\n**Query Params:**\n- Reserved: `page`, `limit`, `order_by`, `order_dir`\n- Filters: `title__like`, `content__like`, `authorId__eq`, `createdAt__gte`, `createdAt__lte`, `createdAt__between`, `id__in`\n\n**Filter operations:** `eq`, `like`, `gt`, `gte`, `lt`, `lte`, `in`, `between`\n\n**Example:** `?title__like=honey&order_by=createdAt&order_dir=desc&page=1&limit=10`\n\n**Response:** `{ results: [...], page, limit, nextPage }`"
          },
          "response": []
        },
        {
          "name": "GET /facts/popular",
          "event": [
            {
              "listen": "pre-request",
              "script": {
                "exec": [
                  "// Dynamic query param builder for GET /facts/popular",
                  "// Sorts by likes count (most liked first) by default",
                  "",
                  "const params = {};",
                  "",
                  "params.page = 1;",
                  "params.limit = 10;",
                  "params.order_by = 'likesCount';",
                  "params.order_dir = 'desc';",
                  "",
                  "// Filter by title or content",
                  "params['title__like'] = 'honey';",
                  "",
                  "const query = Object.entries(params)",
                  "    .filter(([, v]) => v !== undefined && v !== null && v !== '')",
                  "    .map(([k, v]) => encodeURIComponent(k) + '=' + encodeURIComponent(v))",
                  "    .join('&');",
                  "",
                  "pm.request.url.update({",
                  "    raw: '{{baseUrl}}/facts/popular?' + query",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/facts/popular?page=1&limit=10&order_by=likesCount&order_dir=desc&title__like=honey",
              "host": ["{{baseUrl}}"],
              "path": ["facts", "popular"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page (default: 20)"
                },
                {
                  "key": "order_by",
                  "value": "likesCount",
                  "description": "Sort field: likesCount (default), createdAt"
                },
                {
                  "key": "order_dir",
                  "value": "desc",
                  "description": "Sort direction: asc, desc (default: desc)"
                },
                {
                  "key": "title__like",
                  "value": "honey",
                  "description": "Filter: title contains text",
                  "disabled": true
                },
                {
                  "key": "authorId__eq",
                  "value": "",
                  "description": "Filter: exact author ID match",
                  "disabled": true
