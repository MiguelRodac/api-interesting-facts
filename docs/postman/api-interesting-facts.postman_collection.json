{
  "info": {
    "name": "Social Facts API",
    "description": "API for social facts with Firebase Auth, PostgreSQL + Prisma. Use `POST /auth/dev-login` (dev-only) to get a token, then set `{{token}}` to test protected endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3009",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "devLoginSecret",
      "value": "tu-dev-secret-aqui",
      "type": "string"
    },
    {
      "key": "testFactId",
      "value": "",
      "type": "string"
    },
    {
      "key": "testUserId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ping",
              "host": ["{{baseUrl}}"],
              "path": ["ping"]
            },
            "description": "Health check - returns PONG"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/dev-login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}",
                  "if (jsonData.firebaseUid) {",
                  "    pm.collectionVariables.set('testUserId', jsonData.firebaseUid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"secret\": \"{{devLoginSecret}}\",\n  \"email\": \"test@example.com\",\n  \"password\": \"test-password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/dev-login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "dev-login"]
            },
            "description": "**Dev-only.** Generate a Firebase token for testing without a real Firebase Auth setup. Set `{{devLoginSecret}}` in the environment variables. After running, `{{token}}` and `{{testUserId}}` are set automatically."
          },
          "response": []
        },
        {
          "name": "POST /auth/profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"johndoe\",\n  \"displayName\": \"John Doe\",\n  \"avatarUrl\": \"https://example.com/avatar.png\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "profile"]
            },
            "description": "Create user profile (onboarding). First step after Firebase login."
          },
          "response": []
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Get current user profile (requires auth)"
          },
          "response": []
        },
        {
          "name": "PATCH /auth/me",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"John Updated\",\n  \"avatarUrl\": \"https://example.com/new-avatar.png\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Update current user profile (displayName, avatarUrl). Cannot change username or email."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "GET /users/:username",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/johndoe",
              "host": ["{{baseUrl}}"],
              "path": ["users", "johndoe"]
            },
            "description": "Get public profile by username (no auth required). Returns username, displayName, avatarUrl, createdAt. Does NOT return email."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Facts",
      "item": [
        {
          "name": "GET /facts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/facts",
              "host": ["{{baseUrl}}"],
              "path": ["facts"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (default: 20, max: 100)"
                },
                {
                  "key": "order_by",
                  "value": "createdAt",
                  "description": "Sort: createdAt | updatedAt (default: createdAt)"
                },
                {
                  "key": "order_dir",
                  "value": "desc",
                  "description": "Direction: asc | desc (default: desc)"
                },
                {
                  "key": "title__like",
                  "value": "",
                  "description": "Filter: title contains text (case-insensitive)",
                  "disabled": true
                },
                {
                  "key": "content__like",
                  "value": "",
                  "description": "Filter: content contains text",
                  "disabled": true
                },
                {
                  "key": "authorId__eq",
                  "value": "",
                  "description": "Filter: exact author ID",
                  "disabled": true
                },
                {
                  "key": "createdAt__gte",
                  "value": "",
                  "description": "Filter: createdAt >= date (YYYY-MM-DD)",
                  "disabled": true
                },
                {
                  "key": "createdAt__lte",
                  "value": "",
                  "description": "Filter: createdAt <= date (YYYY-MM-DD)",
                  "disabled": true
                },
                {
                  "key": "createdAt__between",
                  "value": "",
                  "description": "Filter: date range (YYYY-MM-DD,YYYY-MM-DD)",
                  "disabled": true
                }
              ]
            },
            "description": "Get all facts sorted by newest first (public, no auth)\n\n**Toggle query params in the Params tab to test combinations.**\n\n**Reserved:** `page`, `limit`, `order_by`, `order_dir`\n**Filters:** `title__like`, `content__like`, `authorId__eq`, `createdAt__gte`, `createdAt__lte`, `createdAt__between`\n\n**Filter ops:** `__like` (contains), `__eq` (exact), `__gt/gte/lt/lte` (comparisons), `__in` (comma-separated), `__between` (comma-separated)\n\n**Response:** `{ results: [...], page, limit, nextPage }`"
          },
          "response": []
        },
        {
          "name": "GET /facts/popular",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/facts/popular",
              "host": ["{{baseUrl}}"],
              "path": ["facts", "popular"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (default: 20, max: 100)"
                },
                {
                  "key": "order_by",
                  "value": "likesCount",
                  "description": "Sort: likesCount (default) | createdAt | updatedAt"
                },
                {
                  "key": "order_dir",
                  "value": "desc",
                  "description": "Direction: asc | desc (default: desc)"
                },
                {
                  "key": "title__like",
                  "value": "",
                  "description": "Filter: title contains text",
                  "disabled": true
                },
                {
                  "key": "content__like",
                  "value": "",
                  "description": "Filter: content contains text",
                  "disabled": true
                },
                {
                  "key": "authorId__eq",
                  "value": "",
                  "description": "Filter: exact author ID",
                  "disabled": true
                }
              ]
            },
            "description": "Get all facts sorted by likes count (most liked first, public)\n\n**Toggle query params in the Params tab to test combinations.**\n\n**Response:** `{ results: [...], page, limit, nextPage }`"
          },
          "response": []
        },
        {
          "name": "GET /facts/:id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/facts/REPLACE_WITH_ID",
              "host": ["{{baseUrl}}"],
              "path": ["facts", "REPLACE_WITH_ID"]
            },
            "description": "Get a single fact by ID (public)"
          },
          "response": []
        },
        {
          "name": "GET /facts/author/:authorId",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/facts/author/REPLACE_WITH_UID",
              "host": ["{{baseUrl}}"],
              "path": ["facts", "author", "REPLACE_WITH_UID"]
            },
            "description": "Get all facts by a specific author (public)"
          },
          "response": []
        },
        {
          "name": "POST /facts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('testFactId', jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Did you know?\",\n  \"content\": \"Honey never spoils. Archaeologists found 3000-year-old honey in Egyptian tombs.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/facts",
              "host": ["{{baseUrl}}"],
              "path": ["facts"]
            },
            "description": "Create a new fact. Content must be 10-200 characters. Requires auth + completed profile. After creation, `{{testFactId}}` is set automatically."
          },
          "response": []
        },
        {
          "name": "PATCH /facts/:id",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\",\n  \"content\": \"Updated content with more than 10 characters.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/facts/REPLACE_WITH_ID",
              "host": ["{{baseUrl}}"],
              "path": ["facts", "REPLACE_WITH_ID"]
            },
            "description": "Update a fact (author only, returns 403 if not the author)"
          },
          "response": []
        },
        {
          "name": "DELETE /facts/:id",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/facts/REPLACE_WITH_ID",
              "host": ["{{baseUrl}}"],
              "path": ["facts", "REPLACE_WITH_ID"]
            },
            "description": "Delete a fact (author only, returns 403 if not the author)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Likes",
      "item": [
        {
          "name": "POST /facts/:factId/likes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/facts/REPLACE_WITH_FACT_ID/likes",
              "host": ["{{baseUrl}}"],
              "path": ["facts", "REPLACE_WITH_FACT_ID", "likes"]
            },
            "description": "Like a fact. Returns 409 if already liked, 404 if fact doesn't exist."
          },
          "response": []
        },
        {
          "name": "DELETE /facts/:factId/likes",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/facts/REPLACE_WITH_FACT_ID/likes",
              "host": ["{{baseUrl}}"],
              "path": ["facts", "REPLACE_WITH_FACT_ID", "likes"]
            },
            "description": "Unlike a fact. Returns 404 if like doesn't exist."
          },
          "response": []
        },
        {
          "name": "GET /facts/:factId/likes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/facts/{{testFactId}}/likes",
              "host": ["{{baseUrl}}"],
              "path": ["facts", "{{testFactId}}", "likes"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (default: 20, max: 100)"
                },
                {
                  "key": "order_by",
                  "value": "createdAt",
                  "description": "Sort: createdAt (default)"
                },
                {
                  "key": "order_dir",
                  "value": "desc",
                  "description": "Direction: asc | desc (default: desc)"
                }
              ]
            },
            "description": "Get all likes for a fact (public, no auth)\n\n**Toggle query params in the Params tab to test combinations.**\n\n**Response:** `{ results: [...], page, limit, nextPage }`"
          },
          "response": []
        },
        {
          "name": "GET /users/:userId/likes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{testUserId}}/likes",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{testUserId}}", "likes"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default: 1)"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "Items per page (default: 20, max: 100)"
                },
                {
                  "key": "order_by",
                  "value": "createdAt",
                  "description": "Sort: createdAt (default)"
                },
                {
                  "key": "order_dir",
                  "value": "desc",
                  "description": "Direction: asc | desc (default: desc)"
                }
              ]
            },
            "description": "Get all likes by a user (public, no auth)\n\n**Toggle query params in the Params tab to test combinations.**\n\n**Response:** `{ results: [...], page, limit, nextPage }`"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Documentation",
      "item": [
        {
          "name": "GET /api/docs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/docs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "docs"]
            },
            "description": "OpenAPI docs via Scalar (open, no auth required)"
          },
          "response": []
        }
      ]
    }
  ]
}
