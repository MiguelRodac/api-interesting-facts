        {
          "name": "Query Params",
          "item": [
            {
              "name": "GET /facts — Pagination",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/facts?page=2&limit=5&order_by=createdAt&order_dir=asc",
                  "host": ["{{baseUrl}}"],
                  "path": ["facts"],
                  "query": [
                    { "key": "page", "value": "2" },
                    { "key": "limit", "value": "5" },
                    { "key": "order_by", "value": "createdAt" },
                    { "key": "order_dir", "value": "asc" }
                  ]
                },
                "description": "Paginated list: page 2 with 5 items per page, oldest first.\n\n**Reserved params:**\n- `page`: page number (default 1)\n- `limit`: items per page (default 20)\n- `order_by`: `createdAt` | `likesCount`\n- `order_dir`: `asc` | `desc`\n\n**Response:** `{ results: [...], page, limit, nextPage }`"
              },
              "response": []
            },
            {
              "name": "GET /facts — Filter by title (like)",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/facts?title__like=honey",
                  "host": ["{{baseUrl}}"],
                  "path": ["facts"],
                  "query": [
                    { "key": "title__like", "value": "honey" }
                  ]
                },
                "description": "Filter facts whose title contains 'honey' (case-insensitive SQL LIKE %honey%).\n\n**Filter syntax:** `field__operation`\n- `__like` → SQL LIKE %value%\n- `__eq` → exact match\n- `__gt`, `__gte`, `__lt`, `__lte` → comparisons\n- `__in` → value in array (?id__in=1,2,3)\n- `__between` → range (?createdAt__between=2024-01-01,2024-12-31)"
              },
              "response": []
            },
            {
              "name": "GET /facts — Filter by content (like)",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/facts?content__like=archaeolog",
                  "host": ["{{baseUrl}}"],
                  "path": ["facts"],
                  "query": [
                    { "key": "content__like", "value": "archaeolog" }
                  ]
                },
                "description": "Filter facts whose content contains 'archaeolog'."
              },
              "response": []
            },
            {
              "name": "GET /facts — Filter by author",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/facts?authorId__eq={{testUserId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["facts"],
                  "query": [
                    { "key": "authorId__eq", "value": "{{testUserId}}" }
                  ]
                },
                "description": "Filter facts by exact author ID using `authorId__eq`."
              },
              "response": []
            },
            {
              "name": "GET /facts — Filter by date range",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/facts?createdAt__gte=2024-01-01&createdAt__lte=2024-12-31",
                  "host": ["{{baseUrl}}"],
                  "path": ["facts"],
                  "query": [
                    { "key": "createdAt__gte", "value": "2024-01-01" },
                    { "key": "createdAt__lte", "value": "2024-12-31" }
                  ]
                },
                "description": "Filter facts created between two dates (YYYY-MM-DD format).\n\n**Date operations:**\n- `createdAt__gte` → date >= value\n- `createdAt__lte` → date <= value\n- `createdAt__between` → between two dates (?createdAt__between=2024-01-01,2024-12-31)"
              },
              "response": []
            },
            {
              "name": "GET /facts — Combined filters + pagination",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/facts?title__like=honey&createdAt__gte=2024-01-01&order_by=likesCount&order_dir=desc&page=1&limit=10",
