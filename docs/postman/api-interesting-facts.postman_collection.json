    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/dev-login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "}",
                  "if (jsonData.firebaseUid) {",
                  "    pm.collectionVariables.set('testUserId', jsonData.firebaseUid);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"secret\": \"{{devLoginSecret}}\",\n  \"email\": \"test@example.com\",\n  \"password\": \"test-password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/dev-login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "dev-login"]
            },
            "description": "**Dev-only.** Generate a Firebase token for testing without a real Firebase Auth setup. Set `{{devLoginSecret}}` in the environment variables. After running, `{{token}}` and `{{testUserId}}` are set automatically."
          },
          "response": []
        },
        {
          "name": "POST /auth/profile",
