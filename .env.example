# API Interesting Facts - Environment Variables
# Copiar este archivo a .env y completar los valores

version=0.0.1
NODE_ENV=development
PINO_LOG_LEVEL=debug
PORT=3000
MIN_APP_VERSION=1.0.0
DOTENV_TIPS=false

# PostgreSQL Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME

# Firebase Service Account
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=tu-project-id
FIREBASE_CLIENT_EMAIL=tu-service-account@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\NTU_PRIVATE_KEY_AQUI\n-----END PRIVATE KEY-----"

# Firebase Web API Key (public key for client operations)
# Firebase Console > Project Settings > General > Web API Key
FIREBASE_API_KEY=tu-web-api-key-aqui

# Tracing
# Header name for trace ID (used in logs for request tracking)
TRACE_ID_HEADER=x-trace-id

# CORS
# Origin permitido para CORS (ej: http://localhost:5173 para Vite dev)
# En produccion apuntar al dominio del frontend
CORS_ORIGIN=http://localhost:5173

# Base URL (cambiar en produccion)
BASE_URL=http://localhost:3000

# Keep-alive cron (opcional — para evitar que DB externas como Render Postgres se duerman)
# Cuantos ms sin requests antes de hacer un ping a la DB (default: 20 min)
# 20 min = 1200000 ms | 10 min = 600000 ms | 5 min = 300000 ms
KEEP_ALIVE_IDLE_THRESHOLD_MS=1200000

# Rate limit global (solo produccion)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Rate limit para endpoints de autocomplete (/hashtags, /users/search)
# Default: 200 requests por window
AUTOCOMPLETE_RATE_LIMIT=200

# Sentry (opcional — para tracking de errores en produccion)
SENTRY_DSN=tu-sentry-dsn-aqui
