# API Interesting Facts - Environment Variables
# Copiar este archivo a .env y completar los valores
#
# IMPORTANTE: TODAS las variables de la sección REQUIRED son obligatorias.
# Si falta una (o viene vacía), la API NO arranca. No hay valores por defecto.

# ─── Required ──────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# PostgreSQL Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DB_NAME

# Firebase Service Account
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=tu-project-id
FIREBASE_CLIENT_EMAIL=tu-service-account@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_PRIVATE_KEY_AQUI\n-----END PRIVATE KEY-----"

# Firebase Web API Key (public key for client operations)
# Firebase Console > Project Settings > General > Web API Key
FIREBASE_API_KEY=tu-web-api-key-aqui

# Logging
# Niveles válidos: trace | debug | info | warn | error | fatal
PINO_LOG_LEVEL=debug

# Tracing — nombre del header para el trace ID en logs y respuestas
TRACE_ID_HEADER=x-trace-id

# CORS — origen permitido del frontend
# En desarrollo: http://localhost:5173 (Vite) o http://localhost:8081
# En producción: dominio del frontend
CORS_ORIGIN=http://localhost:8081

# Base URL — usada para construir los `type` de errores RFC9457
# En producción apuntar al dominio desplegado de la API
BASE_URL=http://localhost:3000

# ─── Version check ─────────────────────────────────────────────────────────

# true = rechazar requests sin header X-App-Version (400). false = solo para dev/tests
# Las versiones mínimas por plataforma se configuran dinámicamente en la tabla `app_versions` de la DB.
STRICT_VERSION_CHECK=true


# ─── Rate limiting (solo aplica en NODE_ENV=production) ────────────────────

# Límite global: max requests por ventana por IP
RATE_LIMIT_MAX=100
# Ventana en ms (900000 = 15 min)
RATE_LIMIT_WINDOW_MS=900000
# Límite mayor para autocomplete (/hashtags, /users/search, /facts/search)
AUTOCOMPLETE_RATE_LIMIT=200

# ─── Keep-alive DB ──────────────────────────────────────────────────────────

# Ping a la DB tras este ms sin requests (evita que DBs externas se duerman)
# 20 min = 1200000 ms | 10 min = 600000 ms | 5 min = 300000 ms
KEEP_ALIVE_IDLE_THRESHOLD_MS=1200000

# ─── Admin / Maintenance ──────────────────────────────────────────────────
# Token secreto para endpoints administrativos (ej. POST /ping/refresh-versions)
ADMIN_API_KEY=tu-admin-api-key-secreta-aqui

# ─── Optional ───────────────────────────────────────────────────────────────

# Sentry — tracking de errores en producción (dejar vacío para desactivar)
SENTRY_DSN=

