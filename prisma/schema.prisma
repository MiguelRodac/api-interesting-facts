generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  firebaseUid String   @id @map("firebase_uid")
  email       String   @unique
  username    String   @unique
  displayName String   @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  avatarColor String?  @map("avatar_color")
  createdAt   DateTime @default(now()) @map("created_at")

  facts               Fact[]
  likes               Like[]
  comments            Comment[]
  reposts             Repost[]
  commentLikes        CommentLike[]
  mentionsAsAuthor    Mention[]     @relation("MentionAuthor")
  mentionsAsMentioned Mention[]     @relation("MentionedUser")

  @@map("users")
}

model AvatarOption {
  id        String   @id @default(uuid())
  url       String?  @unique
  color     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("avatar_options")
}

model Fact {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [firebaseUid])
  title     String?
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  likes        Like[]
  factHashtags FactHashtag[]
  comments     Comment[]
  reposts      Repost[]
  mentions     Mention[]

  @@map("facts")
}

model Hashtag {
  id        String   @id @default(uuid())
  tag       String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  factHashtags FactHashtag[]

  @@map("hashtags")
}

model FactHashtag {
  factId    String  @map("fact_id")
  hashtagId String  @map("hashtag_id")
  fact      Fact    @relation(fields: [factId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([factId, hashtagId])
  @@map("fact_hashtags")
}

model Like {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  factId    String?  @map("fact_id")
  repostId  String?  @map("repost_id")
  user      User     @relation(fields: [userId], references: [firebaseUid], onDelete: Cascade)
  fact      Fact?    @relation(fields: [factId], references: [id], onDelete: Cascade)
  repost    Repost?  @relation(fields: [repostId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([factId, userId])
  @@index([factId])
  @@index([repostId])
  @@map("likes")
}

model Comment {
  id              String   @id @default(uuid())
  content         String
  factId          String?  @map("fact_id")
  repostId        String?  @map("repost_id")
  authorId        String   @map("author_id")
  parentCommentId String?  @map("parent_comment_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  fact         Fact?         @relation(fields: [factId], references: [id], onDelete: Cascade)
  repost       Repost?       @relation(fields: [repostId], references: [id], onDelete: Cascade)
  author       User          @relation(fields: [authorId], references: [firebaseUid], onDelete: Cascade)
  parent       Comment?      @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies      Comment[]     @relation("CommentReplies")
  commentLikes CommentLike[]
  mentions     Mention[]

  @@index([authorId, createdAt(sort: Desc)])
  @@index([factId, parentCommentId, createdAt(sort: Desc)])
  @@index([factId, createdAt(sort: Desc)])
  @@index([repostId, createdAt(sort: Desc)])
  @@index([parentCommentId, authorId])
  @@map("comments")
}

model Repost {
  id             String   @id @default(uuid())
  originalFactId String   @map("original_fact_id")
  authorId       String   @map("author_id")
  createdAt      DateTime @default(now()) @map("created_at")

  originalFact Fact      @relation(fields: [originalFactId], references: [id], onDelete: Cascade)
  author       User      @relation(fields: [authorId], references: [firebaseUid], onDelete: Cascade)
  likes        Like[]
  comments     Comment[]

  @@unique([authorId, originalFactId])
  @@index([originalFactId, createdAt(sort: Desc)])
  @@map("reposts")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [firebaseUid], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("comment_likes")
}

model Mention {
  id              String   @id @default(uuid())
  factId          String?  @map("fact_id")
  commentId       String?  @map("comment_id")
  authorId        String   @map("author_id")
  mentionedUserId String   @map("mentioned_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  fact          Fact?    @relation(fields: [factId], references: [id], onDelete: Cascade)
  comment       Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  author        User     @relation("MentionAuthor", fields: [authorId], references: [firebaseUid], onDelete: Cascade)
  mentionedUser User     @relation("MentionedUser", fields: [mentionedUserId], references: [firebaseUid], onDelete: Cascade)

  @@index([mentionedUserId, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@map("mentions")
}

model AppVersion {
  id                 String   @id @default(uuid())
  platform           String   @default("all")
  minVersion         String   @map("min_version")
  recommendedVersion String?  @map("recommended_version")
  forceUpdate        Boolean  @default(true) @map("force_update")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([platform])
  @@map("app_versions")
}

view ViewFactsRepostPagination {
  id             String   @unique
  type           String   // "fact" | "repost"
  originalFactId String   @map("original_fact_id")
  authorId       String   @map("author_id")
  createdAt      DateTime @map("created_at")

  @@map("view_facts_repost_pagination")
}
